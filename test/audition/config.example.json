{
  "_comment": "Copy to config.json and edit. config.json is not tracked: everything in it is local to one machine.",

  "rack": {
    "cwd": "~/dl/audio/rack",
    "command": ["./Rack"],
    "home": "~/dl/audio/rackhome"
  },

  "audio": {
    "driver": 2,
    "deviceName": "your sound card, exactly as Rack names it",
    "sampleRate": 48000,
    "blockSize": 256
  },

  "scratch": "/tmp/forsitan-audition",

  "sine": {
    "plugin": "Fundamental", "model": "VCO",
    "hp": 10, "out": 0, "freq_param": 0, "ref": 261.6256
  },

  "sources": {
    "drums": {
      "plugin": "4msCompany", "model": "BWAVP", "hp": 8,
      "out": 0, "out_r": 1,
      "data": "/path/to/a/drum/loop.wav"
    }
  },

  "bench": {
    "artifex": {"in": ["left", "right"], "out": ["left", "right"]}
  }
}
